{
  "name": "tessera",
  "version": "0.1.0",
  "targets": [
    "claude",
    "codex",
    "openclaw",
    "hermes"
  ],
  "routing": {
    "codigo": "codex",
    "revisao": "claude",
    "resumo": "hermes",
    "automacao": "openclaw"
  },
  "fanout": {
    "agents": [
      "openclaw",
      "claude",
      "codex",
      "hermes"
    ],
    "synthesizer": "claude",
    "mode": "cascade",
    "fast": "openclaw",
    "autoVerify": true,
    "fastDeadlineSeconds": 120,
    "hedgeSeconds": 20,
    "budgetSeconds": 150,
    "microAgent": "openclaw",
    "deadlineSeconds": 120,
    "branchDeadlineSeconds": 180,
    "maxConcurrent": 2,
    "synthTimeoutSeconds": 180,
    "quorum": 2,
    "graceSeconds": 15,
    "maxCharsPerBranch": 6000,
    "maxWaitAfterFirstSeconds": 30
  },
  "harness": {
    "claudeTools": "Bash,Read,Write,Edit",
    "codexSandbox": "workspace-write"
  }
}
